[Unit]
Description=Dorothy Claude Code Service
Documentation=https://github.com/eiaserinnys/dorothy-claude-service
After=network.target

[Service]
KillMode=process
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__SERVICE_DIR__/current
ExecStart=__SERVICE_DIR__/shared/.venv/bin/uvicorn src.main:app --host 127.0.0.1 --port 8090 --loop uvloop
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=__SERVICE_DIR__/shared/.env

# 리소스 제한
LimitNOFILE=65536
LimitNPROC=4096

# 보안 설정
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__WORKSPACE_DIR__
ReadWritePaths=__SERVICE_DIR__

# 재시작 정책
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3

# 로깅
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dorothy-claude-service

[Install]
WantedBy=multi-user.target
