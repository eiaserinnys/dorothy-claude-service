# Claude Code Service 환경변수 예시
# 이 파일을 .env로 복사하고 값을 설정하세요

# === 환경 설정 ===
# development, staging, production
ENVIRONMENT=production

# === 서버 설정 ===
HOST=0.0.0.0
PORT=8080

# === 인증 ===
# API 인증 토큰 (필수)
CLAUDE_SERVICE_TOKEN=your-secret-token-here

# Anthropic API 키 (필수 - Claude Code가 사용)
ANTHROPIC_API_KEY=sk-ant-...

# === 작업 디렉토리 ===
# Claude Code가 작업하는 디렉토리 (환경에 맞게 설정)
WORKSPACE_DIR=/path/to/workspace

# === 리소스 제한 ===
MAX_CONCURRENT_SESSIONS=3
SESSION_TIMEOUT_SECONDS=1800

# === 로깅 ===
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# json (프로덕션), text (개발)
LOG_FORMAT=json
