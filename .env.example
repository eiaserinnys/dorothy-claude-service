# Claude Code Service 환경변수 예시
# 이 파일을 .env로 복사하고 값을 설정하세요

# API 인증 토큰 (필수)
CLAUDE_SERVICE_TOKEN=your-secret-token-here

# Anthropic API 키 (필수 - Claude Code가 사용)
ANTHROPIC_API_KEY=sk-ant-...

# 작업 디렉토리 (Docker 볼륨 마운트 경로)
WORKSPACE_DIR=/home/eias/claude-workspace

# 동시 세션 제한
MAX_CONCURRENT_SESSIONS=3

# 로그 레벨
LOG_LEVEL=INFO
